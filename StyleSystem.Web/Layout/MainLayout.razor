@inherits LayoutComponentBase

<div class="page-wrapper">
        <!-- Navbar -->
    <nav class="main-navbar">
        <div class="navbar-container">
            <!-- Logo -->
            <a href="/" class="navbar-logo">
                Style<span style="color: #ec4899;">System</span>
            </a>

            <!-- Desktop Navigation -->
            <div class="navbar-menu desktop-menu">
                <a href="/" class="nav-link">Home</a>
                <a href="#features" class="nav-link">Features</a>
                <a href="#how-it-works" class="nav-link">How It Works</a>
                <a href="#about" class="nav-link">About</a>
            </div>

            <!-- Auth Buttons -->
            <div class="navbar-actions">
                <a href="login" class="btn btn-outline-nav">Login</a>
                <a href="register" class="btn btn-primary-nav">Sign Up</a>
            </div>

            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu">
                @if (isMobileMenuOpen)
                {
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                }
                else
                {
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                }
            </button>
        </div>

        <!-- Mobile Menu Dropdown -->
        @if (isMobileMenuOpen)
        {
            <div class="mobile-menu">
                <a href="/" class="mobile-nav-link" @onclick="CloseMobileMenu">Home</a>
                <a href="#features" class="mobile-nav-link" @onclick="CloseMobileMenu">Features</a>
                <a href="#how-it-works" class="mobile-nav-link" @onclick="CloseMobileMenu">How It Works</a>
                <a href="#about" class="mobile-nav-link" @onclick="CloseMobileMenu">About</a>
                <div class="mobile-menu-divider"></div>
                <a href="/login" class="mobile-nav-link" @onclick="CloseMobileMenu">Login</a>
                <a href="/register" class="mobile-nav-link primary" @onclick="CloseMobileMenu">Sign Up</a>
            </div>
        }
    </nav>

    <!-- Page Content -->
    <main class="page-content">
        @Body
    </main>

    <!-- Footer (Optional) -->
    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-section">
                <h4 class="footer-title">Style<span style="color: #ec4899;">System</span></h4>
                <p class="footer-text">AI-powered fashion recommendations tailored to your style.</p>
            </div>
            <div class="footer-section">
                <h5 class="footer-heading">Quick Links</h5>
                <a href="/" class="footer-link">Home</a>
                <a href="#features" class="footer-link">Features</a>
                <a href="#about" class="footer-link">About</a>
            </div>
            <div class="footer-section">
                <h5 class="footer-heading">Support</h5>
                <a href="#" class="footer-link">Help Center</a>
                <a href="#" class="footer-link">Contact</a>
                <a href="#" class="footer-link">FAQ</a>
            </div>
            <div class="footer-section">
                <h5 class="footer-heading">Legal</h5>
                <a href="#" class="footer-link">Privacy Policy</a>
                <a href="#" class="footer-link">Terms of Service</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 StyleSystem. All rights reserved.</p>
        </div>
    </footer>
</div>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }
}