@inherits LayoutComponentBase

<div class="page-wrapper">
        <!-- Navbar -->
    <nav class="main-navbar">
        <div class="navbar-container">
            <!-- Logo -->
            <a href="" class="navbar-logo">
                Style<span style="color: #ec4899;">System</span>
            </a>

            <!-- Desktop Navigation -->
            <div class="navbar-menu desktop-menu">
                <a href="" class="nav-link">Úy</a>
                <a href="#features" class="nav-link">Ózgeshelikler</a>
                <a href="#how-it-works" class="nav-link">Qanday isleydi</a>
                <a href="#about" class="nav-link">Haqqında</a>
            </div>

            <!-- Auth Buttons -->
            <div class="navbar-actions">
                <a href="login" class="btn btn-outline-nav">Kiriw</a>
                <a href="register" class="btn btn-primary-nav">Dizimnen ótiw</a>
            </div>

            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu">
                @if (isMobileMenuOpen)
                {
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                }
                else
                {
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                }
            </button>
        </div>

        <!-- Mobile Menu Dropdown -->
        @if (isMobileMenuOpen)
        {
            <div class="mobile-menu">
                <a href="" class="mobile-nav-link" @onclick="CloseMobileMenu">Úy</a>
                <a href="#features" class="mobile-nav-link" @onclick="CloseMobileMenu">Ózgeshelikler</a>
                <a href="#how-it-works" class="mobile-nav-link" @onclick="CloseMobileMenu">Qanday isleydi</a>
                <a href="#about" class="mobile-nav-link" @onclick="CloseMobileMenu">Haqqında</a>
                <div class="mobile-menu-divider"></div>
                <a href="login" class="mobile-nav-link" @onclick="CloseMobileMenu">Kiriw</a>
                <a href="register" class="mobile-nav-link primary" @onclick="CloseMobileMenu">Dizimnen ótiw</a>
            </div>
        }
    </nav>

    <!-- Page Content -->
    <main class="page-content">
        @Body
    </main>

    <!-- Footer (Optional) -->
    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-section">
                <h4 class="footer-title">Style<span style="color: #ec4899;">System</span></h4>
                <p class="footer-text">Jasalma intellekt ja'rdeminde moda usınısları.</p>
            </div>
            <div class="footer-section">
                <h5 class="footer-heading">Tez Siltemeler</h5>
                <a href="" class="footer-link">Úy</a>
                <a href="#features" class="footer-link">Ózgeshelikler</a>
                <a href="#how-it-works" class="nav-link">Qanday isleydi</a>
                <a href="#about" class="footer-link">Haqqında</a>
            </div>
            <div class="footer-section">
                <h5 class="footer-heading">Qollaw</h5>
                <a href="#" class="footer-link">Járdem orayı</a>
                <a href="#" class="footer-link">Baylanıs</a>
                <a href="#" class="footer-link">FAQ</a>
            </div>
            <div class="footer-section">
                <h5 class="footer-heading">Huqıqıy</h5>
                <a href="#" class="footer-link">Qáwipsizlik siyasatı</a>
                <a href="#" class="footer-link">Paydalanıw shártleri</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 StyleSystem. Barlıq huqıqlar qorǵalǵan.</p>
        </div>
    </footer>
</div>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }
}