@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page-wrapper">
    <!-- Authenticated Navbar -->
    <nav class="auth-navbar">
        <div class="navbar-container">
            <!-- Logo -->
            <a href="/dashboard" class="navbar-logo">
                Style<span style="color: #ec4899;">System</span>
            </a>

            <!-- Desktop Navigation -->
            <div class="navbar-menu desktop-menu">
                <a href="/dashboard" class="nav-link @GetActiveClass("/dashboard")">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    Dashboard
                </a>
                <a href="/recommendations" class="nav-link @GetActiveClass("/recommendations")">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                    Get Recommendations
                </a>
                <a href="/results" class="nav-link @GetActiveClass("/results")">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="12" y1="20" x2="12" y2="10"></line>
                        <line x1="18" y1="20" x2="18" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="16"></line>
                    </svg>
                    Results
                </a>
            </div>

            <!-- User Menu -->
            <div class="navbar-actions">
                <!-- User Dropdown -->
                <div class="user-menu-wrapper">
                    <button class="user-menu-toggle" @onclick="ToggleUserMenu">
                        <div class="user-avatar">
                            <span>@GetUserInitials()</span>
                        </div>
                        <span class="user-name">@currentUserName</span>
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="dropdown-icon @(isUserMenuOpen ? "open" : "")">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    <!-- Dropdown Menu -->
                    @if (isUserMenuOpen)
                    {
                        <div class="user-dropdown">
                            <div class="dropdown-header">
                                <div class="user-avatar-large">
                                    <span>@GetUserInitials()</span>
                                </div>
                                <div class="user-info">
                                    <div class="user-fullname">@currentUserFullName</div>
                                    <div class="user-username">@@@currentUserName</div>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/profile" class="dropdown-item" @onclick="CloseUserMenu">
                                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                Profile
                            </a>
                            <a href="/settings" class="dropdown-item" @onclick="CloseUserMenu">
                                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M12 1v6m0 6v6m6.22-15.78l-4.24 4.24m0 6.36l4.24 4.24M23 12h-6m-6 0H1m15.78 6.22l-4.24-4.24m0-6.36l-4.24-4.24"></path>
                                </svg>
                                Settings
                            </a>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item logout-btn" @onclick="HandleLogout">
                                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                                Logout
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu">
                @if (isMobileMenuOpen)
                {
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                }
                else
                {
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                }
            </button>
        </div>

        <!-- Mobile Menu -->
        @if (isMobileMenuOpen)
        {
            <div class="mobile-menu">
                <!-- User Info -->
                <div class="mobile-user-info">
                    <div class="user-avatar-large">
                        <span>@GetUserInitials()</span>
                    </div>
                    <div class="user-info">
                        <div class="user-fullname">@currentUserFullName</div>
                        <div class="user-username">@@@currentUserName</div>
                    </div>
                </div>
                <div class="mobile-menu-divider"></div>
                
                <!-- Navigation Links -->
                <a href="/dashboard" class="mobile-nav-link" @onclick="CloseMobileMenu">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    Dashboard
                </a>
                <a href="/recommendations" class="mobile-nav-link" @onclick="CloseMobileMenu">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                    Get Recommendations
                </a>
                <a href="/my-styles" class="mobile-nav-link" @onclick="CloseMobileMenu">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                    </svg>
                    My Styles
                </a>
                
                <div class="mobile-menu-divider"></div>
                
                <a href="/profile" class="mobile-nav-link" @onclick="CloseMobileMenu">Profile</a>
                <a href="/settings" class="mobile-nav-link" @onclick="CloseMobileMenu">Settings</a>
                
                <div class="mobile-menu-divider"></div>
                
                <button class="mobile-nav-link logout-btn" @onclick="HandleLogout">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    Logout
                </button>
            </div>
        }
    </nav>

    <!-- Page Content -->
    <main class="auth-page-content">
        @Body
    </main>
</div>

@code {
    private bool isMobileMenuOpen = false;
    private bool isUserMenuOpen = false;
    
    // TODO: Get from authentication service
    private string currentUserName = "johndoe";
    private string currentUserFullName = "John Doe";

    private string GetActiveClass(string path)
    {
        return Navigation.Uri.Contains(path) ? "active" : "";
    }

    private string GetUserInitials()
    {
        if (string.IsNullOrWhiteSpace(currentUserFullName))
            return "U";
        
        var names = currentUserFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (names.Length >= 2)
            return $"{names[0][0]}{names[1][0]}".ToUpper();
        
        return names[0][0].ToString().ToUpper();
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
        if (isMobileMenuOpen)
            isUserMenuOpen = false;
    }

    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
    }

    private void CloseUserMenu()
    {
        isUserMenuOpen = false;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private void HandleLogout()
    {
        // TODO: Clear authentication token
        // await LocalStorage.RemoveItemAsync("authToken");
        
        // Close menus
        isUserMenuOpen = false;
        isMobileMenuOpen = false;
        
        // Navigate to login
        Navigation.NavigateTo("/login");
    }
}
