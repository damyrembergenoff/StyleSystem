@page "/history"
@layout AuthenticatedLayout

<div class="history-container">
    <div class="history-header">
        <h1 class="page-title">Your Recommendation History</h1>
        <p class="page-subtitle">View your past style recommendations</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading your history...</p>
        </div>
    }
    else if (recommendations.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg width="64" height="64" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                    <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
            </div>
            <h3>No recommendations yet</h3>
            <p>Create your first style recommendation to see it here.</p>
            <button class="btn btn-primary" @onclick="NavigateToRecommendations">Get Started</button>
        </div>
    }
    else
    {
        <div class="history-list">
            @foreach (var rec in recommendations)
            {
                <div class="history-item" @onclick="() => ViewRecommendation(rec.Id)">
                    <div class="history-content">
                        <div class="history-meta">
                            <span class="history-date">@rec.CreatedAt?.ToString("MMM dd, yyyy")</span>
                            @if (!string.IsNullOrEmpty(rec.Occasion))
                            {
                                <span class="history-occasion">. @rec.Occasion </span>
                            }
                        </div>
                        <div class="history-preview">
                            @GetPreviewText(rec.RecommendationText)
                        </div>
                        <div class="history-images">
                            @if (rec.Images.Count > 0)
                            {
                                <div class="image-count">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                        <circle cx="9" cy="9" r="2"/>
                                        <path d="m21 15-3.086-3.086a2 2 0 00-2.828 0L6 21"/>
                                    </svg>
                                    @rec.Images.Count image@(rec.Images.Count > 1 ? "s" : "")
                                </div>
                            }
                        </div>
                    </div>
                    <div class="history-arrow">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M9 5l7 7-7 7"/>
                        </svg>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject] public required IHttpClientFactory HttpClientFactory { get; set; }
    [Inject] public required NavigationManager NavigationManager { get; set; }

    private bool isLoading = true;
    private List<RecommendationHistoryItem> recommendations = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            var privateHttp = HttpClientFactory.CreateClient("Private");
            var response = await privateHttp.GetFromJsonAsync<List<StyleSystem.Shared.DTOs.Recommendations.RecommendationResponseDto>>("api/recommendations/history");

            if (response != null)
            {
                recommendations = response.Select(r => new RecommendationHistoryItem
                {
                    Id = r.Id,
                    Occasion = r.Occasion,
                    RecommendationText = r.RecommendationText,
                    Images = r.Images,
                    CreatedAt = r.CreatedAt.DateTime
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading history: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetPreviewText(string? text)
    {
        if (string.IsNullOrEmpty(text))
            return "No recommendation text available";

        const int maxLength = 150;
        if (text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength) + "...";
    }

    private void ViewRecommendation(Guid id)
    {
        NavigationManager.NavigateTo($"/results/{id}");
    }

    private void NavigateToRecommendations()
    {
        NavigationManager.NavigateTo("/recommendations");
    }

    public class RecommendationHistoryItem
    {
        public Guid Id { get; set; }
        public string? Occasion { get; set; }
        public string? RecommendationText { get; set; }
        public List<StyleSystem.Shared.DTOs.Recommendations.RecommendationImageDto> Images { get; set; } = new();
        public DateTime? CreatedAt { get; set; }
    }
}