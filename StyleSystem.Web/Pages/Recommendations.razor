@page "/recommendations"
@using Microsoft.AspNetCore.Authorization
@using StyleSystem.Shared.Dtos.Recommendations
@attribute [Authorize]
@layout AuthenticatedLayout
@inject NavigationManager Navigation
@inject StyleSystem.Web.Services.RecommendationApiService RecommendationApi
@inject StyleSystem.Web.Services.RecommendationStateService RecommendationState

<div class="recommendations-page-wrapper">
    <div class="recommendations-page-content">
        <!-- Page Header -->
        <div class="page-header-compact">
            <h1 class="page-title-compact">Get New Style Recommendations ✨</h1>
            <p class="page-subtitle-compact">Fill in just a few details and we&apos;ll do the rest.</p>
        </div>

        <!-- Form Container -->
        <div class="form-container-auth">
            <form @onsubmit="HandleGenerate" @onsubmit:preventDefault>
                <!-- Destination -->
                <div class="input-group fade-in">
                    <label for="occasion" class="input-label">Where are you going? *</label>
                    <input 
                        type="text" 
                        @bind="occasion" 
                        id="occasion" 
                        class="input-field" 
                        placeholder="e.g., Wedding, Office, Casual outing, Gym..."
                    />
                </div>

                <!-- Season -->
                <div class="input-group fade-in">
                    <label for="season" class="input-label">Season *</label>
                    <select @bind="selectedSeason" id="season" class="input-field input-select">
                        <option value="">Select season</option>
                        <option value="Spring">🌸 Spring</option>
                        <option value="Summer">☀️ Summer</option>
                        <option value="Fall">🍂 Fall</option>
                        <option value="Winter">❄️ Winter</option>
                    </select>
                </div>

                <!-- Temperature -->
                <div class="input-group fade-in">
                    <label for="temperature" class="input-label">Temperature *</label>
                    <select @bind="selectedTemperature" id="temperature" class="input-field input-select">
                        <option value="">Select temperature</option>
                        <option value="Hot">🌡️ Hot (25°C+)</option>
                        <option value="Warm">☀️ Warm (18-25°C)</option>
                        <option value="Cool">🌤️ Cool (10-18°C)</option>
                        <option value="Cold">❄️ Cold (below 10°C)</option>
                    </select>
                </div>

                <!-- Additional Preferences -->
                <div class="input-group fade-in">
                    <label for="preferences" class="input-label">Additional Preferences (Optional)</label>
                    <textarea 
                        @bind="additionalPreferences" 
                        id="preferences" 
                        class="input-field input-textarea" 
                        placeholder="Tell us more about your style preferences, colors you like, comfort requirements, etc."
                        rows="3"
                    ></textarea>
                </div>

                <!-- Generate Button -->
                <div class="form-actions-center">
                    <button type="button" class="btn btn-outline btn-large" @onclick="GoBack">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-generate btn-large" disabled="@(!IsFormValid() || isLoading)">
                        @if (isLoading)
                        {
                            <div class="spinner"></div>
                            <span>Generating...</span>
                        }
                        else
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                            </svg>
                            <span>Generate Recommendations</span>
                        }
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-message">@errorMessage</div>
                }
            </form>
        </div>
    </div>
</div>

@code {
    private string occasion = "";
    private string selectedSeason = "";
    private string selectedTemperature = "";
    private string additionalPreferences = "";

    private string errorMessage = "";
    private bool isLoading = false;

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(occasion)
            && !string.IsNullOrWhiteSpace(selectedSeason)
            && !string.IsNullOrWhiteSpace(selectedTemperature);
    }

    private async Task HandleGenerate()
    {
        if (!IsFormValid())
        {
            errorMessage = "Please fill in all required fields.";
            return;
        }

        isLoading = true;
        errorMessage = "";

        try
        {
            var dto = new CreateRecommendationDto
            {
                Occasion = occasion,
                Season = selectedSeason,
                Temperature = selectedTemperature,
                AdditionalPreferences = string.IsNullOrWhiteSpace(additionalPreferences)
                    ? null
                    : additionalPreferences
            };

            var result = await RecommendationApi.CreateAsync(dto);

            if (result == null)
            {
                errorMessage = "Failed to generate recommendation.";
                return;
            }

            var images = result.Images?
                .Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl))
                .Select(i => i.ImageUrl!)
                .ToList() ?? new List<string>();

            RecommendationState.SetResult(result.RecommendationText, images);
            Navigation.NavigateTo("authresults");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to generate recommendations: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("dashboard");
}

