@page "/dashboard"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject DashboardService DashboardService
@using Microsoft.AspNetCore.Authorization
@using StyleSystem.Shared.Dtos.Dashboard
@using StyleSystem.Web.Auth
@using StyleSystem.Web.Components
@using StyleSystem.Web.Services

<div class="dashboard-container">
    <!-- Welcome Section -->
    <div class="dashboard-header">
        <div class="welcome-section">
            <h1 class="dashboard-title">Xosh keldińiz!, @userName! 👋</h1>
            <p class="dashboard-subtitle">Búgin ózińizdiń jetik usılıńızdı tabıwǵa tayarsız ba?</p>
        </div>
        <div class="header-actions">
            <a href="recommendations" class="btn btn-primary btn-large">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                </svg>
                Stil usınısların alıw
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-value">@totalRecommendations</div>
                <div class="stat-label">Jámi usınıslar</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                <!-- Calendar icon for This Month -->
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-value">@thisMonth</div>
                <div class="stat-label">Bul ay</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                <!-- User/Profile icon -->
                <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-value">85%</div>
                <div class="stat-label">Profil tolıqlıǵı</div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="dashboard-section">
        <h2 class="section-title">Tez ámeller</h2>
        <div class="quick-actions-grid">
            <a href="recommendations" class="action-card">
                <div class="action-icon primary">
                    <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                </div>
                <h3 class="action-title">Jańa usınıs</h3>
                <p class="action-description">Hár qanday mánzil ushın AI járdeminde kiyim usınısların alıń.</p>
            </a>

            <a href="profile" class="action-card">
                <div class="action-icon secondary">
                    <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <h3 class="action-title">Profildi jańalaw</h3>
                <p class="action-description">Stilińizdi hám gewde túrin ózgertiń.</p>
            </a>

            <a href="#" class="action-card" @onclick="@(() => showComingSoon = true)" @onclick:preventDefault>
                <div class="action-icon accent">
                    <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <h3 class="action-title">Stiller kitapxanası</h3>
                <p class="action-description">Kiyim modaların kóriw hám saqlaw</p>
            </a>
        </div>
    </div>

    <!-- Recent Recommendations -->
    <div class="dashboard-section">
        <div class="section-header">
            <h2 class="section-title">Sońǵı usınıslar</h2>
            <a href="history" class="section-link">Hámmesin kóriw →</a>
        </div>

        @if (dashboardData?.RecentActivities?.Count > 0)
        {
            <div class="recommendations-grid">
                @foreach (var activity in dashboardData.RecentActivities.Take(3))
                {
                    <div class="recommendation-card">
                        <div class="recommendation-image">
                            <NgrokImage Url="@activity.ImageUrl" alt="@activity.Occasion" />
                        </div>
                        <div class="recommendation-content">
                            <h3 class="recommendation-title">@activity.Occasion</h3>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg width="64" height="64" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                </div>
                <h3 class="empty-title">Házirshe usınıslar joq</h3>
                <p class="empty-description">Birinshi stil usınısın jaratıwdan baslań!</p>
                <a href="recommendations" class="btn btn-primary">Baslaw</a>
            </div>
        }
    </div>
</div>

<!-- Coming Soon Modal -->
@if (showComingSoon)
{
    <div class="modal-overlay" @onclick="@(() => showComingSoon = false)">
        <div class="modal-content" @onclick:stopPropagation>
            <h3>Tez arada! 🚀</h3>
            <p>Bul funkciya házirde islep shıǵılmaqta.</p>
            <button class="btn btn-primary" @onclick="@(() => showComingSoon = false)">Túsinikli</button>
        </div>
    </div>
}

@code {
    [Inject] public required AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] public required IConfiguration Configuration { get; set; }
    private string userName = "";
    
    private DashboardDto? dashboardData;
    private int thisMonth = 0;
    private int totalRecommendations = 0;
    
    private bool showComingSoon = false;

    protected override async Task OnInitializedAsync()
    {
        var customAuth = (CustomAuthStateProvider)AuthStateProvider;
        var authState = await customAuth.GetAuthenticationStateAsync();
        var user = authState.User;

        userName = user?.Claims?.FirstOrDefault(c => c.Type.Equals("FullName"))?.Value ?? "";

        dashboardData = await DashboardService.GetAsync();
        if (dashboardData != null)
        {
            totalRecommendations = dashboardData.TotalRecommendations;
            thisMonth = dashboardData.ThisMonth;
        }
    }
}
