@page "/results"
@page "/results/{id}"   

@inject NavigationManager Navigation
@inject StyleSystem.Web.Services.RecommendationStateService RecommendationState
@inject StyleSystem.Web.Services.RecommendationApiService RecommendationApi
@using System.Net.Http.Json
@using StyleSystem.Web.Services

<div class="results-container @(isLoading ? "loading" : "")">
    @if (isLoading)
    {
        <div class="loading-screen">
            <div class="loading-orb"></div>
            <p class="loading-text">Creating your style recommendations...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <p>@errorMessage</p>
            <button class="btn btn-primary" @onclick="GoBack">Go Back</button>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="results-header">
            <button class="back-button" @onclick="GoBack">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
                Back
            </button>
            <div class="header-info">
                <h1 class="results-title">Your Style Recommendations ✨</h1>
            </div>
            <div class="header-actions">
                <button class="btn btn-primary" @onclick="GoBack">New Recommendation</button>
            </div>
        </div>

        <!-- AI Advice Section -->
        @if (!string.IsNullOrEmpty(recommendationText))
        {
            <div class="advice-section">
                <div class="advice-header">
                    <div class="ai-badge">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                        </svg>
                        AI Stylist Advice
                    </div>
                </div>
                <div class="advice-content">
                    <p class="advice-text">@recommendationText</p>
                </div>
            </div>
        }

        <!-- Outfit Gallery -->
        @if (imageUrls.Any())
        {
            <div class="outfit-section">
                <h2 class="section-heading">Recommended Outfits</h2>
                <p class="section-description">
                    Here are @imageUrls.Count curated outfit@(imageUrls.Count > 1 ? "s" : "") based on your preferences
                </p>

                <div class="outfit-gallery">
                    @foreach (var (url, index) in imageUrls.Select((u, i) => (u, i)))
                    {
                        <div class="outfit-card @(selectedOutfit == index ? "selected" : "")"
                             @onclick="@(() => SelectOutfit(index))">
                            <div class="outfit-image-wrapper">
                                <img src="@GetFullImageUrl(url)" alt="Outfit @(index + 1)" class="outfit-image"/>
                                @if (selectedOutfit == index)
                                {
                                    <div class="selected-badge">
                                        <svg width="20" height="20" fill="white" viewBox="0 0 24 24">
                                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                        </svg>
                                    </div>
                                }
                                <div class="outfit-number">Option @(index + 1)</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (string.IsNullOrEmpty(recommendationText) && !imageUrls.Any())
        {
            <div class="empty-state" style="text-align:center; padding: 4rem 2rem;">
                <h3>No recommendation data found</h3>
                <p>Please go back and generate a new recommendation.</p>
                <button class="btn btn-primary" @onclick="GoBack">Try Again</button>
            </div>
        }

        <!-- Bottom Actions -->
        <div class="bottom-actions">
            <button class="btn btn-outline btn-large" @onclick="GoBack">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                </svg>
                New Recommendation
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private int selectedOutfit = 0;

    private string? recommendationText;
    private List<string> imageUrls = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(Id))
            {
                await LoadAuthenticatedResult(Id);
            }
            else
            {
                LoadAnonymousResult();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load recommendation: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void LoadAnonymousResult()
    {
        if (!RecommendationState.HasResult)
        {
            Navigation.NavigateTo("/");
            return;
        }

        recommendationText = RecommendationState.RecommendationText;
        imageUrls          = RecommendationState.ImageUrls;
        RecommendationState.Clear();
    }

    private async Task LoadAuthenticatedResult(string id)
    {
        try
        {
            var response = await RecommendationApi.GetByIdAsync(Guid.Parse(id));
            if (response != null)
            {
                recommendationText = response.RecommendationText;
                imageUrls = response.Images.Select(i => i.ImageUrl ?? "").ToList();
            }
            else
            {
                errorMessage = "Recommendation not found";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load recommendation: {ex.Message}";
        }
    }

    private string GetFullImageUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        if (url.StartsWith("http://") || url.StartsWith("https://")) return url;
        return $"http://localhost:5000/{url.TrimStart('/')}";
    }

    private void SelectOutfit(int index) => selectedOutfit = index;

    private void GoBack()
    {
        RecommendationState.Clear();
        Navigation.NavigateTo("/");
    }
}
