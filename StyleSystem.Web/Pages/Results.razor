@page "/results"
@page "/results/{id}"
@layout AuthenticatedLayout

<div class="results-container">
    <!-- Header -->
    <div class="results-header">
        <button class="back-button" @onclick="GoBack">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back
        </button>
        <div class="header-info">
            <h1 class="results-title">Your Style Recommendations ✨</h1>
            <p class="results-subtitle">Based on: <span class="occasion-tag">@occasionName</span></p>
        </div>
        <div class="header-actions">
            <button class="btn-icon-action" title="Save">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                </svg>
            </button>
            <button class="btn-icon-action" title="Share">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="18" cy="5" r="3"></circle>
                    <circle cx="6" cy="12" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
            </button>
            <button class="btn btn-primary" @onclick="CreateNew">
                New Recommendation
            </button>
        </div>
    </div>

    <!-- AI Advice Section -->
    <div class="advice-section">
        <div class="advice-header">
            <div class="ai-badge">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                </svg>
                AI Stylist Advice
            </div>
        </div>
        <div class="advice-content">
            <p class="advice-text">@aiAdvice</p>
        </div>
        
        <!-- Style Tips -->
        <div class="style-tips">
            <h3 class="tips-heading">💡 Styling Tips:</h3>
            <ul class="tips-list-compact">
                @foreach (var tip in stylingTips)
                {
                    <li>@tip</li>
                }
            </ul>
        </div>
    </div>

    <!-- Outfit Gallery -->
    <div class="outfit-section">
        <h2 class="section-heading">Recommended Outfits</h2>
        <p class="section-description">Here are @outfitImages.Count curated outfit@(outfitImages.Count > 1 ? "s" : "") based on your preferences</p>
        
        <div class="outfit-gallery">
            @foreach (var (outfit, index) in outfitImages.Select((o, i) => (o, i)))
            {
                <div class="outfit-card @(selectedOutfit == index ? "selected" : "")" @onclick="@(() => SelectOutfit(index))">
                    <div class="outfit-image-wrapper">
                        <img src="@outfit.ImageUrl" alt="@outfit.Title" class="outfit-image" />
                        @if (selectedOutfit == index)
                        {
                            <div class="selected-badge">
                                <svg width="20" height="20" fill="white" viewBox="0 0 24 24">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </svg>
                            </div>
                        }
                        <div class="outfit-number">Option @(index + 1)</div>
                    </div>
                    <div class="outfit-info">
                        <h3 class="outfit-title">@outfit.Title</h3>
                        <p class="outfit-description">@outfit.Description</p>
                        
                        <!-- Outfit Details -->
                        <div class="outfit-details">
                            @if (!string.IsNullOrEmpty(outfit.TopWear))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Top:</span>
                                    <span class="detail-value">@outfit.TopWear</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(outfit.BottomWear))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Bottom:</span>
                                    <span class="detail-value">@outfit.BottomWear</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(outfit.Footwear))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Shoes:</span>
                                    <span class="detail-value">@outfit.Footwear</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(outfit.Accessories))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Accessories:</span>
                                    <span class="detail-value">@outfit.Accessories</span>
                                </div>
                            }
                        </div>

                        <!-- Color Palette -->
                        @if (outfit.Colors.Any())
                        {
                            <div class="color-palette">
                                <span class="palette-label">Colors:</span>
                                <div class="palette-colors">
                                    @foreach (var color in outfit.Colors)
                                    {
                                        <div class="color-swatch" style="background: @color;" title="@color"></div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div class="outfit-actions">
                            <button class="btn-action-small">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                                </svg>
                                Save
                            </button>
                            <button class="btn-action-small">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                                    <polyline points="16 6 12 2 8 6"></polyline>
                                    <line x1="12" y1="2" x2="12" y2="15"></line>
                                </svg>
                                Share
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Additional Actions -->
    <div class="bottom-actions">
        <button class="btn btn-outline btn-large" @onclick="RegenerateRecommendations">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            Regenerate
        </button>
        <button class="btn btn-primary btn-large" @onclick="ApplyToWardrobe">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Add to My Wardrobe
        </button>
    </div>
</div>

