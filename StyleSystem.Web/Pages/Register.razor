@page "/register"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<div class="auth-container">
    <div class="auth-card fade-in">
        <!-- Logo / Brand -->
        <div style="text-align: center; margin-bottom: 2rem;">
            <a href="" style="text-decoration: none;">
                <h1 class="logo" style="color: #6366f1; font-size: 2rem;">
                    Style<span style="color: #ec4899;">System</span>
                </h1>
            </a>
        </div>

        <!-- Title -->
        <h2 class="auth-title">Create Account</h2>
        <p class="auth-subtitle">Sign up to get personalized style recommendations</p>

        <!-- Register Form -->
        <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <!-- Full Name -->
            <div class="input-group">
                <label for="fullName">Full Name</label>
                <InputText 
                    @bind-Value="registerModel.FullName" 
                    id="fullName" 
                    class="input-field" 
                    placeholder="John Doe"
                />
                <ValidationMessage For="@(() => registerModel.FullName)" style="color: #ef4444; font-size: 0.875rem; margin-top: 0.25rem;" />
            </div>

            <!-- Username -->
            <div class="input-group">
                <label for="username">Username</label>
                <InputText 
                    @bind-Value="registerModel.Username" 
                    id="username" 
                    class="input-field" 
                    placeholder="johndoe"
                />
                <ValidationMessage For="@(() => registerModel.Username)" style="color: #ef4444; font-size: 0.875rem; margin-top: 0.25rem;" />
            </div>

            <!-- Password -->
            <div class="input-group">
                <label for="password">Password</label>
                <InputText 
                    @bind-Value="registerModel.Password" 
                    id="password" 
                    class="input-field" 
                    placeholder="••••••••"
                    type="password"
                />
                <ValidationMessage For="@(() => registerModel.Password)" style="color: #ef4444; font-size: 0.875rem; margin-top: 0.25rem;" />
                <p style="font-size: 0.75rem; color: #6b7280; margin-top: 0.25rem;">
                    Must be at least 6 characters
                </p>
            </div>

            <!-- Confirm Password -->
            <div class="input-group">
                <label for="confirmPassword">Confirm Password</label>
                <InputText 
                    @bind-Value="registerModel.ConfirmPassword" 
                    id="confirmPassword" 
                    class="input-field" 
                    placeholder="••••••••"
                    type="password"
                />
                <ValidationMessage For="@(() => registerModel.ConfirmPassword)" style="color: #ef4444; font-size: 0.875rem; margin-top: 0.25rem;" />
            </div>

            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #dc2626; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.875rem;">
                    @errorMessage
                </div>
            }

            <!-- Success Message -->
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div style="background: #d1fae5; border: 1px solid #6ee7b7; color: #065f46; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.875rem;">
                    @successMessage
                </div>
            }

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-large btn-full" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Creating account...</span>
                }
                else
                {
                    <span>Create Account</span>
                }
            </button>
        </EditForm>

        <!-- Login Link -->
        <p class="text-center" style="margin-top: 1.5rem; color: #6b7280; font-size: 0.875rem;">
            Already have an account? 
            <a href="login" class="auth-link">Sign in</a>
        </p>
    </div>
</div>