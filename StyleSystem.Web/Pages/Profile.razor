@page "/profile"
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using StyleSystem.Web.Auth
@attribute [Authorize]
@layout AuthenticatedLayout

<div class="profile-container">
    <!-- Page Header -->
    <div class="profile-header">
        <div class="header-left">
            <h1 class="page-title">My Profile</h1>
            <p class="page-subtitle">Manage your personal information and preferences</p>
        </div>
        <div class="header-right">
            @if (isEditing)
            {
                <button class="btn btn-outline" @onclick="CancelEdit">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveProfile" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span>Saving...</span>
                        <div class="spinner"></div>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="EnableEdit">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    Edit Profile
                </button>
            }
        </div>
    </div>

    <!-- Profile Content -->
    <div class="profile-content">
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success">
                @SuccessMessage
                <button class="alert-close" @onclick="ClearSuccessMessage">&times;</button>
            </div>
        }
        <!-- Left Column: Avatar & Stats -->
        <div class="profile-sidebar">
            <!-- Avatar Section -->
            <div class="avatar-section">
                <div class="avatar-wrapper">
                    <div class="avatar-large">
                        <span>@GetUserInitials()</span>
                    </div>
                    @if (isEditing)
                    {
                        <button class="avatar-change-btn" title="Change Avatar">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                <circle cx="12" cy="13" r="4"></circle>
                            </svg>
                        </button>
                    }
                </div>
                <h2 class="user-display-name">@userProfile.FullName</h2>
                <p class="user-username">@Username</p>
            </div>
        </div>

        <!-- Right Column: Profile Form -->
        <div class="profile-main">
            <EditForm Model="@userProfile" OnValidSubmit="SaveProfile">
                <DataAnnotationsValidator />

                <!-- Personal Information -->
                <div class="form-section-card">
                    <h3 class="section-card-title">Personal Information</h3>
                    
                    <div class="form-grid-profile">
                        <div class="form-group">
                            <label class="form-label">Full Name</label>
                            @if (isEditing)
                            {
                                <InputText @bind-Value="userProfile.FullName" class="form-input" placeholder="John Doe" />
                                <ValidationMessage For="@(() => userProfile.FullName)" class="validation-message" />
                            }
                            else
                            {
                                <div class="form-display-value">@userProfile.FullName</div>
                            }
                        </div>

                        <div class="form-group">
                            <label class="form-label">Username</label>
                            <div class="form-display-value readonly">@Username</div>
                            <span class="form-hint">Username cannot be changed</span>
                        </div>
                    </div>
                </div>

                <!-- Body & Style Information -->
                <div class="form-section-card">
                    <h3 class="section-card-title">Body & Style Preferences</h3>
                    
                    <div class="form-grid-profile">
                        <div class="form-group">
                            <label class="form-label">Gender</label>
                            @if (isEditing)
                            {
                                <select @bind="userProfile.Gender" @onchanged="OnGenderChanged" class="form-select">
                                    <option value="">Select gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            }
                            else
                            {
                                <div class="form-display-value">@(string.IsNullOrEmpty(userProfile.Gender) ? "Not set" : userProfile.Gender)</div>
                            }
                        </div>

                        <div class="form-group">
                            <label class="form-label">Body Type</label>
                            @if (isEditing)
                            {
                                <select @bind="userProfile.BodyType" class="form-select">
                                    <option value="">Select body type</option>
                                    @foreach (var option in availableBodyTypes)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="form-display-value">@(string.IsNullOrEmpty(userProfile.BodyType) ? "Not set" : userProfile.BodyType)</div>
                            }
                        </div>

                        <div class="form-group">
                            <label class="form-label">Age</label>
                            @if (isEditing)
                            {
                                <InputNumber @bind-Value="userProfile.Age" class="form-input" placeholder="25" />
                                <ValidationMessage For="@(() => userProfile.Age)" class="validation-message" />
                            }
                            else
                            {
                                <div class="form-display-value">@(userProfile.Age?.ToString() ?? "Not set")</div>
                            }
                        </div>

                        <div class="form-group">
                            <label class="form-label">Skin Tone</label>
                            @if (isEditing)
                            {
                                <select @bind="userProfile.SkinTone" class="form-select">
                                    <option value="">Select skin tone</option>
                                    <option value="Fair">Fair</option>
                                    <option value="Light">Light</option>
                                    <option value="Medium">Medium</option>
                                    <option value="Olive">Olive</option>
                                    <option value="Tan">Tan</option>
                                    <option value="Dark">Dark</option>
                                </select>
                            }
                            else
                            {
                                <div class="form-display-value">@(string.IsNullOrEmpty(userProfile.SkinTone) ? "Not set" : userProfile.SkinTone)</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Account Settings -->
                <div class="form-section-card">
                    <h3 class="section-card-title">Account Settings</h3>
                    
                    <div class="settings-list">
                        <div class="setting-item">
                            <div class="setting-info">
                                <div class="setting-label">Password</div>
                                <div class="setting-description">••••••••</div>
                            </div>
                            <button type="button" class="btn btn-outline btn-sm" @onclick="ChangePassword">
                                Change Password
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="form-section-card danger-zone">
                    <h3 class="section-card-title">Danger Zone</h3>
                    <div class="danger-content">
                        <div class="danger-info">
                            <div class="danger-label">Delete Account</div>
                            <div class="danger-description">Permanently delete your account and all data</div>
                        </div>
                        <button type="button" class="btn btn-danger" @onclick="DeleteAccount">
                            Delete Account
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<!-- Change Password Modal -->
@if (showPasswordModal)
{
    <div class="modal-overlay" @onclick="ClosePasswordModal">
        <div class="modal-content" @onclick:stopPropagation>
            <h3>Change Password</h3>
            
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger">
                    @ErrorMessage
                    <button class="alert-close" @onclick="() => ErrorMessage = string.Empty">&times;</button>
                </div>
            }

            <div class="form-group">
                <label class="form-label">Current Password</label>
                <input type="password" @bind="currentPassword" class="form-input" placeholder="••••••••" />
            </div>
            <div class="form-group">
                <label class="form-label">New Password</label>
                <input type="password" @bind="newPassword" class="form-input" placeholder="••••••••" />
            </div>
            <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <input type="password" @bind="confirmPassword" class="form-input" placeholder="••••••••" />
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="ClosePasswordModal">Cancel</button>
                <button class="btn btn-primary" @onclick="UpdatePassword">Update Password</button>
            </div>
        </div>
    </div>
}

@code {
    [Inject] public required IHttpClientFactory HttpClientFactory { get; set; }
    [Inject] public required NavigationManager NavigationManager { get; set; }
    [Inject] public required IJSRuntime JSRuntime { get; set; }
    [Inject] public required ILocalStorageService localStorageService { get; set; }
    [Inject] public required AuthenticationStateProvider authenticationStateProvider { get; set; }
    
    private StyleSystem.Web.Dtos.CompleteProfile.ProfileModel userProfile = new();
    private bool isEditing = false;
    private bool isSaving = false;
    private bool showPasswordModal = false;
    
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string Username = "";
    private string SuccessMessage = "";
    private string ErrorMessage = "";

    private List<string> availableBodyTypes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
        UpdateAvailableBodyTypes();
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            var privateHttp = HttpClientFactory.CreateClient("Private");
            var response = await privateHttp.GetFromJsonAsync<StyleSystem.Shared.Dtos.UserDto>("api/user/profile");
            if (response != null)
            {
                userProfile.FullName = response.FullName ?? "";
                Username = response.Username ?? "";
                userProfile.Age = response.Age;
                userProfile.Height = response.Height;
                userProfile.Weight = response.Weight;
                userProfile.Gender = response.Gender?.ToString() ?? "";
                userProfile.BodyType = response.Gender == StyleSystem.Shared.Dtos.EGender.Male 
                    ? response.MaleBodyType?.ToString() ?? "" 
                    : response.FemaleBodyType?.ToString() ?? "";
                userProfile.SkinTone = response.SkinTone?.ToString() ?? "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
    }

    private void UpdateAvailableBodyTypes()
    {
        availableBodyTypes = userProfile.Gender switch
        {
            "Male" => new List<string> { "Rectangle", "Triangle", "InvertedTriangle", "Trapezoid", "Oval" },
            "Female" => new List<string> { "Hourglass", "Pear", "Apple", "Rectangle", "InvertedTriangle", "Diamond" },
            _ => new List<string>()
        };
    }

    private void ClearSuccessMessage()
    {
        SuccessMessage = "";
    }

    private string GetUserInitials()
    {
        if (string.IsNullOrWhiteSpace(userProfile.FullName))
            return "U";
        
        var names = userProfile.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (names.Length >= 2)
            return $"{names[0][0]}{names[1][0]}".ToUpper();
        
        return names[0][0].ToString().ToUpper();
    }

    private void EnableEdit()
    {
        SuccessMessage = "";
        isEditing = true;
    }

    private void CancelEdit()
    {
        SuccessMessage = "";
        isEditing = false;
        // Reload original data
        Task.Run(LoadProfileAsync);
    }

    private async Task SaveProfile()
    {
        isSaving = true;

        try
        {
            var privateHttp = HttpClientFactory.CreateClient("Private");
            var response = await privateHttp.PutAsJsonAsync("api/user/profile", userProfile);
            if (response.IsSuccessStatusCode)
            {
                isEditing = false;
                SuccessMessage = "Profile updated successfully!";
                await LoadProfileAsync(); // Reload to get updated data
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error saving profile: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving profile: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ChangePassword()
    {
        showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
        ErrorMessage = "";
    }

    private async Task UpdatePassword()
    {
        ErrorMessage = "";

        // Client-side validation
        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            ErrorMessage = "Current password is required";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            ErrorMessage = "New password is required";
            return;
        }

        if (string.IsNullOrWhiteSpace(confirmPassword))
        {
            ErrorMessage = "Password confirmation is required";
            return;
        }

        if (newPassword.Length < 6)
        {
            ErrorMessage = "New password must be at least 6 characters";
            return;
        }

        if (newPassword != confirmPassword)
        {
            ErrorMessage = "New passwords do not match";
            return;
        }

        try
        {
            var changePasswordDto = new StyleSystem.Shared.Dtos.ChangePasswordDto
            {
                CurrentPassword = currentPassword,
                NewPassword = newPassword,
                ConfirmPassword = confirmPassword
            };

            var privateHttp = HttpClientFactory.CreateClient("Private");
            var response = await privateHttp.PutAsJsonAsync("api/user/change-password", changePasswordDto);

            if (response.IsSuccessStatusCode)
            {
                SuccessMessage = "Password changed successfully!";
                ClosePasswordModal();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ErrorMessage = error;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred while changing the password: {ex.Message}";
            Console.WriteLine($"Error changing password: {ex.Message}");
        }
    }

    private async Task DeleteAccount()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete your account? This action cannot be undone.");
        if (confirmed)
        {
            try
            {
                var privateHttp = HttpClientFactory.CreateClient("Private");
                var response = await privateHttp.DeleteAsync("api/user/me");
                if (response.IsSuccessStatusCode)
                {
                    await localStorageService.RemoveItemAsync("authToken");

                    var customAuth = (CustomAuthStateProvider)authenticationStateProvider;
                    customAuth.NotifyUserLogout();

                    NavigationManager.NavigateTo("/");
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"Error deleting account: {error}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting account: {ex.Message}");
            }
        }
    }
}
