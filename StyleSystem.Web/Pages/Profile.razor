            StyleDescription = "I prefer minimalist, classic styles with clean lines. Comfort is important to me.",
            EmailNotifications = true,
            ProfilePublic = false
        };
    }

    private string GetUserInitials()
    {
        if (string.IsNullOrWhiteSpace(userProfile.FullName))
            return "U";
        
        var names = userProfile.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (names.Length >= 2)
            return $"{names[0][0]}{names[1][0]}".ToUpper();
        
        return names[0][0].ToString().ToUpper();
    }

    private void EnableEdit()
    {
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        // TODO: Reload original data
    }

    private async Task SaveProfile()
    {
        isSaving = true;

        try
        {
            // TODO: Call API to save profile
            // await ProfileService.UpdateAsync(userProfile);
            
            await Task.Delay(1000);
            
            isEditing = false;
            
            // Show success message
            Console.WriteLine("Profile saved successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving profile: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ChangePassword()
    {
        showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
    }

    private async Task UpdatePassword()
    {
        // TODO: Validate and update password
        if (newPassword != confirmPassword)
        {
            // Show error
            return;
        }

        // TODO: Call API
        await Task.Delay(500);
        ClosePasswordModal();
    }

    private void DeleteAccount()
    {
        // TODO: Show confirmation dialog and delete account
        var confirmed = true; // Show confirmation modal
        if (confirmed)
        {
            // Call API to delete account
        }
    }

    public class UserProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Full name is required")]
        public string FullName { get; set; } = "";

        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = "";

        public string PhoneNumber { get; set; } = "";
        public string BodyType { get; set; } = "";
        public string Gender { get; set; } = "";
        public string AgeRange { get; set; } = "";
        public string FavoriteColors { get; set; } = "";
        public string StyleDescription { get; set; } = "";
        public bool EmailNotifications { get; set; }
        public bool ProfilePublic { get; set; }
    }
}
