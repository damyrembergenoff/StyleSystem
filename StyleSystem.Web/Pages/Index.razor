@page "/"

<div class="landing-page">
    <!-- Background Image with Overlay -->
    <div class="landing-bg"></div>

    <!-- Main Content -->
    <div class="landing-content">
        <h1 class="hero-title fade-in">
            AI-Powered Fashion Recommendations
        </h1>
        <p class="hero-subtitle fade-in">
            Describe your body type and occasion, and our AI will generate personalized outfit recommendations tailored just for you.
        </p>

        <!-- Input Area (Similar to Adobe Firefly) -->
        <div class="input-container slide-in-up">
            <form @onsubmit="HandleGenerate">
                <div class="input-group">
                    <label for="bodyType">Body Type</label>
                    <select @bind="bodyType" id="bodyType" class="input-field input-select">
                        <option value="">Select your body type</option>
                        <option value="athletic">Athletic</option>
                        <option value="slim">Slim</option>
                        <option value="curvy">Curvy</option>
                        <option value="plus-size">Plus Size</option>
                        <option value="petite">Petite</option>
                    </select>
                </div>

                <div class="input-group">
                    <label for="occasion">Where are you going?</label>
                    <input 
                        type="text" 
                        @bind="occasion" 
                        id="occasion" 
                        class="input-field" 
                        placeholder="e.g., Wedding, Office, Casual outing, Gym..."
                    />
                </div>

                <div class="input-group">
                    <label for="preferences">Style Preferences (Optional)</label>
                    <textarea 
                        @bind="preferences" 
                        id="preferences" 
                        class="input-field input-textarea" 
                        placeholder="Tell us more about your style... colors, patterns, comfort level, etc."
                    ></textarea>
                </div>

                <button type="submit" class="btn btn-generate btn-full">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                    Generate Style Recommendations
                </button>
            </form>
        </div>

        <!-- Features (Optional) -->
        <div class="features-preview" style="margin-top: 3rem; display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center;">
            <div style="color: white; text-align: center; max-width: 200px;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">🎨</div>
                <div style="font-weight: 600; margin-bottom: 0.25rem;">AI-Powered</div>
                <div style="font-size: 0.875rem; opacity: 0.9;">Smart outfit generation</div>
            </div>
            <div style="color: white; text-align: center; max-width: 200px;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">👔</div>
                <div style="font-weight: 600; margin-bottom: 0.25rem;">Personalized</div>
                <div style="font-size: 0.875rem; opacity: 0.9;">Tailored to your body</div>
            </div>
            <div style="color: white; text-align: center; max-width: 200px;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">⚡</div>
                <div style="font-weight: 600; margin-bottom: 0.25rem;">Instant</div>
                <div style="font-size: 0.875rem; opacity: 0.9;">Results in seconds</div>
            </div>
        </div>
    </div>
</div>

@code {
    private string bodyType = "";
    private string occasion = "";
    private string preferences = "";

    private void HandleGenerate()
    {
        // Check if user is logged in
        // If not, redirect to login
        // Navigation.NavigateTo("/login");

        // TODO: Call API to generate recommendations
        // For now, just log or navigate
        if (string.IsNullOrWhiteSpace(bodyType) || string.IsNullOrWhiteSpace(occasion))
        {
            // Show error message
            return;
        }

        // Navigate to results page or show modal
        Console.WriteLine($"Body Type: {bodyType}");
        Console.WriteLine($"Occasion: {occasion}");
        Console.WriteLine($"Preferences: {preferences}");
        
        // TODO: Navigate to recommendations page
        // Navigation.NavigateTo("/recommendations");
    }
}
