@page "/"
@using StyleSystem.Web.Auth
@inject NavigationManager Navigation
@inject StyleSystem.Web.Services.RecommendationApiService RecommendationApi
@inject StyleSystem.Web.Services.RecommendationStateService RecommendationState
@layout MainLayout

<div class="landing-page">
    <!-- Background Image with Overlay -->
    <div class="landing-bg"></div>

    <!-- Main Content -->
    <div class="landing-content">
        <h1 class="hero-title fade-in">
            Jasalma intellekt ja'rdeminde moda usınısları
        </h1>
        <p class="hero-subtitle fade-in">
            Ózińiz haqqında bir neshe sorawlarǵa juwap beriń hám ózińiz ushın sáykeslengen kiyim usınısların alıń.
        </p>

        <!-- Input Area -->
        <div class="input-container slide-in-up">
            <form @onsubmit="HandleGenerate" @onsubmit:preventDefault="false">
                <!-- Step 1: Gender Selection -->
                <div class="input-group">
                    <label class="input-label">Jınısıńızdı tańlań *</label>
                    <div class="gender-selection">
                        <label class="gender-option @(selectedGender == "Male" ? "selected" : "")">
                            <input type="radio" name="gender" value="Male" @onchange="@(() => SelectGender("Male"))" />
                            <div class="gender-card">
                                <svg width="40" height="40" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2a5 5 0 1 0 5 5 5 5 0 0 0-5-5zm0 8a3 3 0 1 1 3-3 3 3 0 0 1-3 3zm9 11v-1a7 7 0 0 0-7-7h-4a7 7 0 0 0-7 7v1h2v-1a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v1z"/>
                                </svg>
                                <span>Erkek</span>
                            </div>
                        </label>
                        <label class="gender-option @(selectedGender == "Female" ? "selected" : "")">
                            <input type="radio" name="gender" value="Female" @onchange="@(() => SelectGender("Female"))" />
                            <div class="gender-card">
                                <svg width="40" height="40" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2a5 5 0 1 0 5 5 5 5 0 0 0-5-5zm0 8a3 3 0 1 1 3-3 3 3 0 0 1-3 3zm0 1a7 7 0 0 0-7 7v1h14v-1a7 7 0 0 0-7-7zm0 2a5 5 0 0 1 5 5H7a5 5 0 0 1 5-5z"/>
                                </svg>
                                <span>Hayal</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Step 2: Body Type Selection (shown after gender selection) -->
                @if (!string.IsNullOrEmpty(selectedGender))
                {
                    <div class="input-group body-type-section fade-in">
                        <label class="input-label">Dene tipinizdi tańlań *</label>
                        
                        <!-- Body Type Reference Image -->
                        <div class="body-type-reference">
                            <img src="images/@(selectedGender.ToLower())-body-types.png" 
                                 alt="@selectedGender Body Types" 
                                 class="body-types-image" />
                        </div>

                        <!-- Body Type Options -->
                        <div class="body-type-options">
                            @if (selectedGender == "Male")
                            {
                                @foreach (var bodyType in maleBodyTypes)
                                {
                                    <label class="body-type-radio @(selectedBodyType == bodyType.Value ? "selected" : "")">
                                        <input type="radio" 
                                               name="bodyType" 
                                               value="@bodyType.Value" 
                                               @onchange="@(() => selectedBodyType = bodyType.Value)" />
                                        <span class="body-type-label">@bodyType.Display</span>
                                    </label>
                                }
                            }
                            else
                            {
                                @foreach (var bodyType in femaleBodyTypes)
                                {
                                    <label class="body-type-radio @(selectedBodyType == bodyType.Value ? "selected" : "")">
                                        <input type="radio" 
                                               name="bodyType" 
                                               value="@bodyType.Value" 
                                               @onchange="@(() => selectedBodyType = bodyType.Value)" />
                                        <span class="body-type-label">@bodyType.Display</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>

                    <!-- Step 3: Age Range -->
                    <div class="input-group fade-in">
                        <label for="ageRange" class="input-label">Jas aralıǵı *</label>
                        <select @bind="selectedAgeRange" id="ageRange" class="input-field input-select">
                            <option value="">Jas aralıǵıńızdı tanlań</option>
                            <option value="18-25">18-25</option>
                            <option value="26-35">26-35</option>
                            <option value="36-45">36-45</option>
                            <option value="46-55">46-55</option>
                            <option value="56+">56+</option>
                        </select>
                    </div>

                    <!-- Step 4: Occasion -->
                    <div class="input-group fade-in">
                        <label for="occasion" class="input-label">Qayaqqa barmaqshısız? *</label>
                        <input 
                            type="text" 
                            @bind="occasion" 
                            id="occasion" 
                            class="input-field" 
                            placeholder="máselen, Toy, Ofis, Kúndelikli shıǵıw, Sport zalı..."
                        />
                    </div>

                    <!-- Step 5: Season -->
                    <div class="input-group fade-in">
                        <label for="season" class="input-label">Máwsim *</label>
                        <select @bind="selectedSeason" id="season" class="input-field input-select">
                            <option value="">Máwsimdi tanlań</option>
                            <option value="Spring">🌸 Ba'ha'r</option>
                            <option value="Summer">☀️ Jaz</option>
                            <option value="Fall">🍂 Gu'z</option>
                            <option value="Winter">❄️ Qıs</option>
                        </select>
                    </div>

                    <!-- Step 6: Temperature -->
                    <div class="input-group fade-in">
                        <label for="temperature" class="input-label">Temperatura *</label>
                        <select @bind="selectedTemperature" id="temperature" class="input-field input-select">
                            <option value="">Temperaturanı tanlań</option>
                            <option value="Hot">🌡️ Íssı (25°C+)</option>
                            <option value="Warm">☀️ Jıllı (18-25°C)</option>
                            <option value="Cool">🌤️ Salqın (10-18°C)</option>
                            <option value="Cold">❄️ Suwıq (10°C dan to'men)</option>
                        </select>
                    </div>

                    <!-- Step 7: Additional Description (Optional) -->
                    <div class="input-group fade-in">
                        <label for="preferences" class="input-label">Qosımsha parametrler (ma'jbu'riy emes)</label>
                        <textarea 
                            @bind="additionalPreferences" 
                            id="preferences" 
                            class="input-field input-textarea" 
                            placeholder="Ózińiz haqqında kóbirek maǵlıwmat beriń (boyıńız, salmaǵıńız, teri reńińiz), stil qálewlerińiz, sizge unaytuǵın reńler, qolaylıq talapları hám basqalar."
                            rows="3"
                        ></textarea>
                    </div>

                    <!-- Generate Button -->
                    <button type="submit" class="btn btn-generate btn-full" disabled="@(!IsFormValid() || isLoading)">
                        @if (isLoading)
                        {
                            <span>Generating...</span>
                        }
                        else
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                            </svg>
                            <span>Stil Usınısların Jaratıw</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="error-message">@errorMessage</div>
                    }
                }
            </form>
        </div>

        <!-- Features Preview -->
        <div class="features-preview">
            <div class="feature-item">
                <div class="feature-icon">🎨</div>
                <div class="feature-title">AI menen isleytuǵın</div>
                <div class="feature-text">Aqıllı kiyim jaratıwshı</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">👔</div>
                <div class="feature-title">Jekelestirilgen</div>
                <div class="feature-text">Deneńizge say</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">⚡</div>
                <div class="feature-title">Tez waqıtta</div>
                <div class="feature-text">Sekund ishinde nátiyjeler</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] public required AuthenticationStateProvider authenticationStateProvider { get; set; }

    // Form fields
    private string selectedGender = "";
    private string selectedBodyType = "";
    private string selectedAgeRange = "";
    private string occasion = "";
    private string selectedSeason = "";
    private string selectedTemperature = "";
    private string additionalPreferences = "";
    private string errorMessage = "";
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        var customAuth = (CustomAuthStateProvider)authenticationStateProvider;

        var authState = await customAuth.GetAuthenticationStateAsync();
        var user = authState.User;

        if(user.Identity is not null && user.Identity.IsAuthenticated)
            Navigation.NavigateTo("dashboard");
    }

    // Body type mappings
    private List<BodyTypeOption> maleBodyTypes = new()
    {
        new("Rectangle", "Rectangle"),
        new("InvertedTriangle", "Inverted Triangle"),
        new("Trapezoid", "Trapezoid"),
        new("Triangle", "Triangle"),
        new("Oval", "Oval")
    };

    private List<BodyTypeOption> femaleBodyTypes = new()
    {
        new("Rectangle", "Rectangle"),
        new("Pear", "Pear/Triangle"),
        new("Hourglass", "Hourglass"),
        new("InvertedTriangle", "Inverted Triangle"),
        new("Diamond", "Diamond"),
        new("Apple", "Round/Apple")
    };

    private void SelectGender(string gender)
    {
        selectedGender = gender;
        selectedBodyType = "";
        errorMessage = "";
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(selectedGender) &&
               !string.IsNullOrWhiteSpace(selectedBodyType) &&
               !string.IsNullOrWhiteSpace(selectedAgeRange) &&
               !string.IsNullOrWhiteSpace(occasion) &&
               !string.IsNullOrWhiteSpace(selectedSeason) &&
               !string.IsNullOrWhiteSpace(selectedTemperature);
    }

    private async Task HandleGenerate()
    {
        if (!IsFormValid())
        {
            errorMessage = "Iltimas, barlıq kerekli maydanlardı toltırıń.";
            return;
        }

        isLoading = true;
        errorMessage = "";

        try
        {
            var dto = new StyleSystem.Api.Dtos.Recommendations.AnonymousRecommendationDto
            {
                Gender             = selectedGender,
                BodyType           = selectedBodyType,
                AgeRange           = selectedAgeRange,
                Occasion           = occasion,
                Season             = selectedSeason,
                Temperature        = selectedTemperature,
                AdditionalPreferences = string.IsNullOrWhiteSpace(additionalPreferences)
                                        ? null
                                        : additionalPreferences
            };

            var result = await RecommendationApi.CreateAnonymousAsync(dto);

            RecommendationState.SetResult(result?.RecommendationText, result?.ImageUrls ?? []);

            Navigation.NavigateTo("results");
        }
        catch (Exception ex)
        {
            errorMessage = "Usınıslar payda bolmadı. Iltimas, qayta urınıń.";
            Console.WriteLine($"[Index] Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    public class BodyTypeOption
    {
        public string Value { get; set; }
        public string Display { get; set; }

        public BodyTypeOption(string value, string display)
        {
            Value = value;
            Display = display;
        }
    }
}
